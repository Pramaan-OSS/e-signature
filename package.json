{
  "private": true,
  "name": "@e-sign/root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "2.20.0",
  "scripts": {
    "postinstall": "patch-package",
    "build": "turbo run build",
    "dev": "npm run translate:compile && turbo run dev --filter=@e-sign/remix",
    "dev:remix": "npm run translate:compile && turbo run dev --filter=@e-sign/remix",
    "start": "npm run start -w @e-sign/remix",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "biome check --write --no-errors-on-unmatched",
    "format": "biome format --write .",
    "prepare": "husky && husky install || true",
    "commitlint": "commitlint --edit",
    "clean": "turbo run clean && rimraf node_modules",
    "d": "npm run dx && npm run translate:compile && npm run dev",
    "dx": "npm ci && npm run dx:up && npm run prisma:migrate-dev && npm run prisma:seed",
    "dx:up": "docker compose -f docker/development/compose.yml up -d",
    "dx:down": "docker compose -f docker/development/compose.yml down",
    "ci": "turbo run build --filter=@e-sign/remix && turbo run test:e2e",
    "prisma:generate": "npm run with:env -- npm run prisma:generate -w @e-sign/prisma",
    "prisma:migrate-dev": "npm run with:env -- npm run prisma:migrate-dev -w @e-sign/prisma",
    "prisma:migrate-deploy": "npm run with:env -- npm run prisma:migrate-deploy -w @e-sign/prisma",
    "prisma:migrate-reset": "npm run with:env -- npm run prisma:migrate-reset -w @e-sign/prisma",
    "prisma:seed": "npm run with:env -- npm run prisma:seed -w @e-sign/prisma",
    "prisma:studio": "npm run with:env -- npm run prisma:studio -w @e-sign/prisma",
    "with:env": "dotenv -e .env -e .env.local --",
    "reset:hard": "npm run clean && npm i && npm run prisma:generate",
    "precommit": "npm install && git add package.json package-lock.json",
    "make:version": "npm version --workspace @e-sign/remix --include-workspace-root --no-git-tag-version -m \"v%s\"",
    "translate": "npm run translate:extract && npm run translate:compile",
    "translate:extract": "lingui extract --clean",
    "translate:compile": "lingui compile",
    "setup:local": "node scripts/setup-local.mjs && npm run prisma:generate && npm run prisma:migrate-deploy",
    "check:schemas": "node --import tsx scripts/check-pramaan-schemas.ts",
    "check:inline-menus": "node scripts/check-inline-menus.mjs",
    "lint:ci": "biome lint apps packages scripts",
    "test:ci": "npm test -w @e-sign/lib -- --maxWorkers=1 && node --import tsx --test packages/lib/server-only/pramaan/sdk-compat.node-test.ts && node --test scripts/setup-local.test.mjs scripts/check-inline-menus.test.mjs scripts/check-migration-scope.test.mjs"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "npm": ">=11.17.0",
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "@playwright/browser-chromium": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "fsevents": true,
    "prisma": true,
    "core-js": false,
    "msgpackr-extract": false,
    "protobufjs": false,
    "skia-canvas": true
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@lingui/cli": "^5.6.0",
    "@prisma/client": "^6.19.0",
    "@trpc/client": "11.17.0",
    "@trpc/react-query": "11.17.0",
    "@trpc/server": "11.17.0",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "@ts-rest/serverless": "^3.52.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nanoid": "^5.1.6",
    "nodemailer": "^10.0.9",
    "pdfjs-dist": "5.4.296",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.2",
    "playwright": "1.56.1",
    "prisma": "^6.19.0",
    "prisma-extension-kysely": "^3.0.0",
    "prisma-json-types-generator": "^3.6.2",
    "prisma-kysely": "^2.3.0",
    "rimraf": "^6.1.2",
    "superjson": "^2.2.5",
    "syncpack": "^14.0.0-alpha.27",
    "turbo": "^2.10.0",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.4",
    "zod-openapi": "^4.2.4",
    "zod-prisma-types": "3.3.5"
  },
  "dependencies": {
    "@e-sign/prisma": "*",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@libpdf/core": "^0.5.2",
    "@lingui/conf": "^5.6.0",
    "@lingui/core": "^5.6.0",
    "@prisma/extension-read-replicas": "^0.4.1",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-aspect-ratio": "^1.1.11",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "cron-parser": "^5.5.0",
    "fflate": "^0.8.3",
    "luxon": "^3.7.2",
    "patch-package": "^8.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "0.35.5",
    "skia-canvas": "3.0.8",
    "typescript": "5.6.2",
    "zod": "^3.25.76"
  },
  "overrides": {
    "lodash": "4.18.1",
    "brace-expansion@1": "^1.1.18",
    "pdfjs-dist": "5.4.296",
    "postcss": "^8.5.19",
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "5.6.2",
    "zod": "$zod",
    "fumadocs-mdx": {
      "zod": "^4.3.5"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "tailwindcss": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
